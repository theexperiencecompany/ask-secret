#!/bin/zsh
# ask-secret: let a coding agent ask you for a secret through a native macOS pop-up instead of the chat.
set -u

self=${0:A}
root=${self:h:h}
prefix="agent/"

usage() {
	cat <<'EOF'
ask-secret - ask the human for a secret through a macOS pop-up, never through the chat

  ask-secret get NAME --what TEXT --why TEXT [--where URL]
      Print the secret saved as NAME. If it isn't saved yet, ask for it and save it.

  ask-secret once --what TEXT --why TEXT [--where URL]
      Ask for a value, print it, save nothing.

  ask-secret sudo --why TEXT [--on HOST] -- COMMAND...
      Ask for the sudo password and run COMMAND with sudo, here or on HOST over SSH.
      The password is never saved.

  ask-secret list            names of saved secrets
  ask-secret has NAME        exit 0 if NAME is saved
  ask-secret forget NAME     delete a saved secret
  ask-secret install         put ask-secret on your PATH (~/.local/bin)

Secrets are kept in your login Keychain as "agent/NAME".
Exit codes: 0 ok, 1 cancelled or timed out, 2 usage error.
EOF
}

die() { print -u2 -- "ask-secret: $*"; exit 2; }

dialog_bin() {
	local src="$root/dialog.swift"
	local hash=$(shasum "$src" | cut -c1-12)
	local bin="$HOME/Library/Caches/ask-secret/dialog-$hash"
	if [[ ! -x $bin ]]; then
		command -v swiftc >/dev/null || die "the pop-up needs Apple's command line tools: run xcode-select --install"
		mkdir -p "${bin:h}"
		swiftc -O "$src" -o "$bin" 2>/dev/null || die "couldn't build the pop-up from $src"
	fi
	print -r -- "$bin"
}

requester() {
	local agent=""
	if [[ -n ${CLAUDECODE:-} ]]; then agent="Claude Code"
	elif [[ -n ${CODEX_SANDBOX:-}${CODEX_HOME:-}${CODEX_MANAGED_BY_NPM:-} ]]; then agent="Codex"
	elif [[ -n ${CURSOR_AGENT:-}${CURSOR_TRACE_ID:-} ]]; then agent="Cursor"
	elif [[ -n ${OPENCODE:-} ]]; then agent="OpenCode"
	elif [[ -n ${GEMINI_CLI:-} ]]; then agent="Gemini CLI"
	elif [[ -n ${AI_AGENT:-} ]]; then agent=${AI_AGENT%%_*}
	else agent=$(/bin/ps -o comm= -p $PPID 2>/dev/null); agent=${agent:t}
	fi
	local app=""
	if [[ -n ${CONDUCTOR_WORKSPACE_NAME:-} ]]; then app=" in Conductor ($CONDUCTOR_WORKSPACE_NAME)"
	elif [[ -n ${REX_SESSION:-} ]]; then app=" in Rex ($REX_SESSION)"
	elif [[ -n ${TERM_PROGRAM:-} ]]; then app=" in $TERM_PROGRAM"
	fi
	print -r -- "${agent:-An agent}$app"
}

# ask TITLE WHY WHERE FOOTER -> the typed value on stdout
ask() {
	local -a link=()
	[[ -n $3 ]] && link=(--where "$3")
	"$(dialog_bin)" --title "$1" --why "$2" --agent "$(requester)" --folder "${PWD/#$HOME/~}" --footer "$4" "${link[@]}" \
		|| { print -u2 "ask-secret: cancelled"; return 1; }
}

parse() {
	what="" why="" where="" on="" rest=()
	while (( $# )); do
		case $1 in
			--what) what=${2:-}; shift 2 ;;
			--why) why=${2:-}; shift 2 ;;
			--where) where=${2:-}; shift 2 ;;
			--on) on=${2:-}; shift 2 ;;
			--) shift; rest+=("$@"); break ;;
			*) rest+=("$1"); shift ;;
		esac
	done
}

cmd=${1:-}
(( $# )) && shift
case $cmd in
	get)
		name=${1:-}; [[ -n $name && $name != --* ]] || die "usage: ask-secret get NAME --what TEXT --why TEXT"
		shift
		parse "$@"
		if value=$(security find-generic-password -s "$prefix$name" -w 2>/dev/null); then
			print -rn -- "$value"
			exit 0
		fi
		[[ -n $what && -n $why ]] || die "$name isn't saved yet, so pass --what and --why to say what you need and why"
		value=$(ask "$what" "$why" "$where" "Saved to your Keychain as $prefix$name") || exit 1
		security add-generic-password -U -s "$prefix$name" -a "$USER" -w "$value" || die "couldn't save to the Keychain"
		print -u2 "ask-secret: saved $prefix$name"
		print -rn -- "$value"
		;;
	once)
		parse "$@"
		[[ -n $what && -n $why ]] || die "usage: ask-secret once --what TEXT --why TEXT"
		ask "$what" "$why" "$where" "Used once, never saved" || exit 1
		;;
	sudo)
		parse "$@"
		[[ -n $why ]] || die "usage: ask-secret sudo --why TEXT [--on HOST] -- COMMAND..."
		(( ${#rest} )) || die "nothing to run: put the command after --"
		machine=${on:-this Mac}
		password=$(ask "Your password on $machine" "$why

Runs: sudo ${rest[*]}" "" "Used once, never saved") || exit 1
		if [[ -n $on ]]; then
			print -r -- "$password" | ssh "$on" "sudo -S -p '' ${(j: :)${(q)rest[@]}}"
		else
			print -r -- "$password" | sudo -S -p '' "${rest[@]}"
		fi
		;;
	list) security dump-keychain 2>/dev/null | grep -o "\"${prefix}[^\"]*\"" | tr -d '"' | sed "s|^$prefix||" | sort -u ;;
	has) [[ -n ${1:-} ]] || die "usage: ask-secret has NAME"; security find-generic-password -s "$prefix$1" >/dev/null 2>&1 || exit 1 ;;
	forget) [[ -n ${1:-} ]] || die "usage: ask-secret forget NAME"; security delete-generic-password -s "$prefix$1" >/dev/null && print "forgot $1" ;;
	install)
		mkdir -p ~/.local/bin
		ln -sf "$self" ~/.local/bin/ask-secret
		dialog_bin >/dev/null
		print "installed: ~/.local/bin/ask-secret"
		[[ :$PATH: == *:$HOME/.local/bin:* ]] || print "add ~/.local/bin to your PATH to run it from anywhere"
		;;
	-h|--help|help|"") usage ;;
	*) die "unknown command '$cmd'. Run ask-secret --help" ;;
esac
