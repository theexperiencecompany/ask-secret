#!/bin/zsh
# ask-secret: let a coding agent ask you for a secret through a native macOS prompt instead of the chat.
set -u

self=${0:A}
root=${self:h:h}

usage() {
	cat <<'EOF'
ask-secret - ask the human for a secret through a macOS prompt, never through the chat

  ask-secret get NAME --what TEXT --why TEXT [--where URL] [--remember WHEN] [--touchid]
      Print the secret saved as NAME. If it isn't saved yet, ask for it.
      WHEN suggests how long to keep it: once, 1h, 1d, 30d or forever (default).
      --touchid suggests asking for Touch ID whenever an agent uses it.
      The human has the final say on both in the prompt.

  ask-secret sudo --why TEXT [--on HOST] -- COMMAND...
      Run COMMAND with sudo, here or on HOST over SSH. The password is asked for
      once and kept behind Touch ID, unless the human chooses otherwise.

  ask-secret once --what TEXT --why TEXT [--where URL]
      Ask for a value, print it, save nothing.

  ask-secret list            saved secrets, how long they're kept, and which need Touch ID
  ask-secret has NAME        exit 0 if NAME is saved
  ask-secret forget NAME     delete a saved secret
  ask-secret lock            end current Touch ID approvals; the next use asks again
  ask-secret install         put ask-secret on your PATH (~/.local/bin)

Exit codes: 0 ok, 1 cancelled or Touch ID declined, 2 usage error.
EOF
}

die() { print -u2 -- "ask-secret: $*"; exit 2; }

helper() {
	local src="$root/helper.swift"
	local hash=$(shasum "$src" | cut -c1-12)
	# Named ask-secret so macOS shows that name in the Touch ID and Keychain prompts.
	local bin="$HOME/Library/Caches/ask-secret/$hash/ask-secret"
	if [[ ! -x $bin ]]; then
		command -v swiftc >/dev/null || die "the prompt needs Apple's command line tools: run xcode-select --install"
		rm -rf "${bin:h:h}"/*(N/)   # helpers built from older versions
		mkdir -p "${bin:h}"
		swiftc -O "$src" -o "$bin" 2>/dev/null || die "couldn't build the prompt from $src"
	fi
	"$bin" "$@"
}

requester() {
	local agent=""
	if [[ -n ${CLAUDECODE:-} ]]; then agent="Claude Code"
	elif [[ -n ${CODEX_SANDBOX:-}${CODEX_HOME:-}${CODEX_MANAGED_BY_NPM:-} ]]; then agent="Codex"
	elif [[ -n ${CURSOR_AGENT:-}${CURSOR_TRACE_ID:-} ]]; then agent="Cursor"
	elif [[ -n ${OPENCODE:-} ]]; then agent="OpenCode"
	elif [[ -n ${GEMINI_CLI:-} ]]; then agent="Gemini CLI"
	elif [[ -n ${AI_AGENT:-} ]]; then agent=${AI_AGENT%%_*}
	else agent=$(/bin/ps -o comm= -p $PPID 2>/dev/null); agent=${agent:t}
	fi
	local app=""
	if [[ -n ${CONDUCTOR_WORKSPACE_NAME:-} ]]; then app=" in Conductor ($CONDUCTOR_WORKSPACE_NAME)"
	elif [[ -n ${REX_SESSION:-} ]]; then app=" in Rex ($REX_SESSION)"
	elif [[ -n ${TERM_PROGRAM:-} ]]; then app=" in $TERM_PROGRAM"
	fi
	print -r -- "${agent:-An agent}$app"
}

parse() {
	what="" why="" where="" on="" remember="forever" touchid="off" rest=()
	while (( $# )); do
		case $1 in
			--what) what=${2:-}; shift 2 ;;
			--why) why=${2:-}; shift 2 ;;
			--where) where=${2:-}; shift 2 ;;
			--on) on=${2:-}; shift 2 ;;
			--remember) remember=${2:-}; shift 2 ;;
			--touchid) touchid="on"; shift ;;
			--) shift; rest+=("$@"); break ;;
			*) rest+=("$1"); shift ;;
		esac
	done
	[[ $remember == (once|1h|1d|30d|forever) ]] || die "--remember must be once, 1h, 1d, 30d or forever"
}

# fetch NAME TITLE WHY WHERE -> the value: saved copy (Touch ID if required) or a new prompt
fetch() {
	local value rc
	value=$(helper read "$1" --why "$3" --agent "$(requester)" --folder "${PWD/#$HOME/~}")
	rc=$?
	(( rc == 0 )) && { print -rn -- "$value"; return 0; }
	(( rc == 3 )) || return 1
	local -a link=()
	[[ -n $4 ]] && link=(--where "$4")
	helper prompt --title "$2" --why "$3" --agent "$(requester)" --folder "${PWD/#$HOME/~}" \
		--store "$1" --remember "$remember" --touchid "$touchid" "${link[@]}"
}

# as_root PASSWORD COMMAND... -> run with sudo, locally or on $on over SSH
as_root() {
	local password=$1; shift
	if [[ -n $on ]]; then
		print -r -- "$password" | ssh "$on" "sudo -S -p '' ${(j: :)${(q)@}}"
	else
		print -r -- "$password" | sudo -S -p '' "$@"
	fi
}

cmd=${1:-}
(( $# )) && shift
case $cmd in
	get)
		name=${1:-}; [[ -n $name && $name != --* ]] || die "usage: ask-secret get NAME --what TEXT --why TEXT"
		shift
		parse "$@"
		[[ -n $why ]] || die "pass --why: it's shown when asking for the secret or for Touch ID"
		if ! helper has "$name"; then
			[[ -n $what ]] || die "$name isn't saved yet, so pass --what to say what you need"
		fi
		fetch "$name" "${what:-$name}" "$why" "$where" || exit 1
		;;
	sudo)
		parse "$@"
		[[ -n $why ]] || die "usage: ask-secret sudo --why TEXT [--on HOST] -- COMMAND..."
		(( ${#rest} )) || die "nothing to run: put the command after --"
		machine=${on:-this Mac}
		name="sudo-${on:-local}"
		[[ $remember == forever && $touchid == off ]] && touchid="on"
		password=$(fetch "$name" "Your password on $machine" "$why

Runs: sudo ${rest[*]}" "") || exit 1
		if ! as_root "$password" -v; then
			helper delete "$name" 2>/dev/null
			print -u2 "ask-secret: that password didn't work on $machine, so it wasn't kept. Run the command again to re-enter it."
			exit 1
		fi
		as_root "$password" "${rest[@]}"
		;;
	once)
		parse "$@"
		[[ -n $what && -n $why ]] || die "usage: ask-secret once --what TEXT --why TEXT"
		local -a link=()
		[[ -n $where ]] && link=(--where "$where")
		helper prompt --title "$what" --why "$why" --agent "$(requester)" --folder "${PWD/#$HOME/~}" "${link[@]}" || exit 1
		;;
	list) helper list ;;
	lock) helper lock && print "locked: agents need Touch ID again" ;;
	has) [[ -n ${1:-} ]] || die "usage: ask-secret has NAME"; helper has "$1" ;;
	forget) [[ -n ${1:-} ]] || die "usage: ask-secret forget NAME"; helper delete "$1" && print "forgot $1" ;;
	install)
		mkdir -p ~/.local/bin
		ln -sf "$self" ~/.local/bin/ask-secret
		helper list >/dev/null
		print "installed: ~/.local/bin/ask-secret"
		[[ :$PATH: == *:$HOME/.local/bin:* ]] || print "add ~/.local/bin to your PATH to run it from anywhere"
		;;
	-h|--help|help|"") usage ;;
	*) die "unknown command '$cmd'. Run ask-secret --help" ;;
esac
